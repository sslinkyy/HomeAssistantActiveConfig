# Copy this file to secrets.yaml on the Home Assistant box (secrets.yaml is gitignored).
# Use the same values for the Frigate add-on environment variables:
#   FRIGATE_MQTT_USER, FRIGATE_MQTT_PASSWORD, FRIGATE_RTSP_PASSWORD
# Optional (two-way probe only — not enabled in config): FRIGATE_DVRIP_PASSWORD
# Never commit secrets.yaml.

frigate_mqtt_user: CHANGE_ME
frigate_mqtt_password: CHANGE_ME
frigate_rtsp_password: CHANGE_ME
frigate_dvrip_password: CHANGE_ME
